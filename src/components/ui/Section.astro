---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../../utils/cn';

interface Props extends HTMLAttributes<'section'> {
  /** Vertical rhythm. `lg` is the default section cadence. */
  spacing?: 'sm' | 'md' | 'lg';
  /** Tints the section background to separate it from its neighbours. */
  tinted?: boolean;
  /** Drops the inner container when a section needs full-bleed children. */
  bleed?: boolean;
}

const { spacing = 'lg', tinted = false, bleed = false, class: className, ...rest } = Astro.props;

const spacings = {
  sm: 'py-10 sm:py-12',
  md: 'py-12 sm:py-14 lg:py-16',
  lg: 'py-14 sm:py-18 lg:py-20',
};
---

<section
  class={cn('relative', spacings[spacing], tinted && 'bg-bg-subtle/60', className)}
  {...rest}
>
  {
    bleed ? (
      <slot />
    ) : (
      <div class="container-page">
        <slot />
      </div>
    )
  }
</section>
