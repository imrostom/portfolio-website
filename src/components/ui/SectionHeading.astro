---
import { cn } from '../../utils/cn';
import Badge from './Badge.astro';

interface Props {
  /** Small label above the title. */
  eyebrow?: string;
  eyebrowIcon?: string;
  title: string;
  /** Trailing words of the title, rendered in the animated gradient. */
  titleAccent?: string;
  description?: string;
  align?: 'left' | 'center';
  /** Heading level — sections use h2, page headers pass 'h1'. */
  as?: 'h1' | 'h2' | 'h3';
  id?: string;
  class?: string;
}

const {
  eyebrow,
  eyebrowIcon,
  title,
  titleAccent,
  description,
  align = 'center',
  as: Tag = 'h2',
  id,
  class: className,
}: Props = Astro.props;

const sizes: Record<NonNullable<Props['as']>, string> = {
  h1: 'text-3xl sm:text-4xl lg:text-5xl',
  h2: 'text-2xl sm:text-3xl lg:text-4xl',
  h3: 'text-xl sm:text-2xl',
};
---

<div
  class={cn(
    'flex flex-col gap-3',
    align === 'center' ? 'items-center text-center' : 'items-start text-left',
    className,
  )}
>
  {
    eyebrow && (
      <Badge variant="brand" icon={eyebrowIcon} data-reveal="fade">
        {eyebrow}
      </Badge>
    )
  }

  <Tag id={id} class={cn(sizes[Tag], 'font-semibold leading-[1.08]')} data-reveal="slide">
    {title}
    {titleAccent && <span class="text-gradient"> {titleAccent}</span>}
  </Tag>

  {
    description && (
      <p
        class={cn(
          'text-[0.95rem] leading-relaxed text-text-muted sm:text-base',
          align === 'center' ? 'max-w-2xl' : 'max-w-2xl',
        )}
        data-reveal="slide"
        style="--reveal-delay:90ms"
      >
        {description}
      </p>
    )
  }
</div>
