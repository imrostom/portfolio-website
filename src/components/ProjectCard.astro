---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { getProjectCover } from '../utils/projectCovers';
import Badge from './ui/Badge.astro';

interface Props {
  project: Project;
  /**
   * Set for cards rendering above the fold. Lazy-loading the LCP image delays
   * it measurably, since the browser will not start the fetch until layout has
   * settled, so the leading row opts out of lazy loading.
   */
  eager?: boolean;
  /**
   * The single most important image on the page. Only one element should carry
   * `fetchpriority="high"` — marking several makes them compete and defeats
   * the point.
   */
  priority?: boolean;
}

const { project, eager = false, priority = false } = Astro.props;
const [from, to] = project.gradient;

/* Real banner if one has been dropped into src/assets/projects/, otherwise the
   generated gradient cover below. */
const cover = getProjectCover(project.slug);

/*
  Only request widths the source can actually supply. Astro never upscales, so
  asking for 900w from a 590px marketplace thumbnail would advertise a srcset
  entry that silently resolves to a smaller file. Capped at 900 because that is
  the widest the card is ever rendered.
*/
const coverWidths = cover
  ? [...new Set([400, 640, 900].filter((w) => w < cover.width).concat(Math.min(cover.width, 900)))]
  : [];
---

<article
  class="project-card group/project relative flex h-full flex-col overflow-hidden rounded-2xl glass shadow-soft"
  data-category={project.category}
  data-reveal="scale"
  style={`--project-from:${from};--project-to:${to}`}
>
  {
    /* Generated cover art — a gradient field with the project's glyph.
      No raster asset means no image weight and no layout shift. */
  }
  <div class="project-card__cover relative aspect-[16/9] w-full overflow-hidden">
    {
      cover ? (
        <>
          <Image
            src={cover}
            alt={`${project.name} — ${project.tagline}`}
            widths={coverWidths}
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
            loading={eager ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
            decoding="async"
            class="project-card__image absolute inset-0 h-full w-full object-cover"
          />
          {/* Keeps the corner badges legible whatever the artwork does. */}
          <div class="project-card__scrim absolute inset-0" aria-hidden="true" />
        </>
      ) : (
        <>
          <div class="project-card__gradient absolute inset-0" />
          <div class="project-card__mesh absolute inset-0" aria-hidden="true" />
          <div class="project-card__grid absolute inset-0" aria-hidden="true" />
          <div class="absolute inset-0 grid place-items-center">
            <Icon
              name={project.icon}
              width={52}
              height={52}
              class="project-card__glyph text-white/90 drop-shadow-lg"
              aria-hidden="true"
            />
          </div>
        </>
      )
    }

    <div class="absolute top-3.5 left-3.5 flex gap-2">
      <span
        class="rounded-full bg-black/35 px-2.5 py-1 text-[0.68rem] font-medium text-white backdrop-blur-md"
      >
        {project.category}
      </span>
    </div>

    <div class="absolute top-3.5 right-3.5">
      <span
        class="rounded-full bg-black/35 px-2.5 py-1 font-mono text-[0.68rem] text-white/90 backdrop-blur-md"
      >
        {project.year}
      </span>
    </div>
  </div>

  {/* Body */}
  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-display text-xl font-semibold tracking-tight">
      {project.name}
    </h3>
    <p class="mt-1 text-sm font-medium text-[var(--project-from)]">{project.tagline}</p>

    <p class="mt-3 text-sm leading-relaxed text-text-muted">{project.description}</p>

    <ul class="mt-5 flex flex-wrap gap-1.5">
      {
        project.stack.map((tech) => (
          <li>
            <Badge variant="muted" class="text-[0.7rem]">
              {tech}
            </Badge>
          </li>
        ))
      }
    </ul>

    {/* Links pinned to the bottom so cards in a row align. */}
    <div class="mt-auto flex flex-wrap items-center gap-2 pt-6">
      {
        project.links.demo && (
          <a
            href={project.links.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link inline-flex items-center gap-1.5 rounded-full border border-border-base px-3.5 py-1.5 text-xs font-medium transition-all duration-300 hover:-translate-y-0.5 hover:border-border-strong hover:bg-surface"
          >
            <Icon name="lucide:external-link" width={13} height={13} aria-hidden="true" />
            Live demo
            <span class="sr-only">of {project.name}</span>
          </a>
        )
      }

      {
        project.links.github && (
          <a
            href={project.links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link inline-flex items-center gap-1.5 rounded-full border border-border-base px-3.5 py-1.5 text-xs font-medium transition-all duration-300 hover:-translate-y-0.5 hover:border-border-strong hover:bg-surface"
          >
            <Icon name="simple-icons:github" width={13} height={13} aria-hidden="true" />
            Source
            <span class="sr-only">of {project.name}</span>
          </a>
        )
      }

      {
        !project.links.demo && !project.links.github && (
          <span class="inline-flex items-center gap-1.5 text-xs text-text-dim">
            <Icon name="lucide:lock" width={13} height={13} aria-hidden="true" />
            Private client work
          </span>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    transition:
      transform 0.55s var(--ease-out-expo),
      box-shadow 0.55s var(--ease-out-expo),
      border-color 0.55s var(--ease-out-expo);
  }

  .project-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lift);
    border-color: color-mix(in oklab, var(--project-from) 40%, transparent);
  }

  .project-card__image {
    transition: transform 0.7s var(--ease-out-expo);
  }

  .project-card:hover .project-card__image {
    transform: scale(1.05);
  }

  /* Darkens only the top strip, where the category and year badges sit. */
  .project-card__scrim {
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.32), transparent 42%);
  }

  .project-card__gradient {
    background: linear-gradient(135deg, var(--project-from), var(--project-to));
    transition: transform 0.7s var(--ease-out-expo);
  }

  .project-card:hover .project-card__gradient {
    transform: scale(1.06);
  }

  /* Soft light blooms layered over the flat gradient. */
  .project-card__mesh {
    background:
      radial-gradient(circle at 22% 28%, rgb(255 255 255 / 0.32), transparent 48%),
      radial-gradient(circle at 78% 76%, rgb(0 0 0 / 0.26), transparent 55%);
    transition: opacity 0.7s var(--ease-out-expo);
  }

  .project-card__grid {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.1) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.1) 1px, transparent 1px);
    background-size: 28px 28px;
    opacity: 0.55;
    transition: opacity 0.7s var(--ease-out-expo);
  }

  .project-card:hover .project-card__grid {
    opacity: 0.9;
  }

  .project-card__glyph {
    transition: transform 0.6s var(--ease-spring);
  }

  .project-card:hover .project-card__glyph {
    transform: scale(1.14) rotate(-5deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card__gradient,
    .project-card__glyph {
      transition: none;
    }
    .project-card:hover {
      transform: none;
    }
    .project-card:hover .project-card__gradient,
    .project-card:hover .project-card__glyph,
    .project-card:hover .project-card__image {
      transform: none;
    }
  }
</style>
