---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import portrait from '../assets/md-rostom-ali-senior-full-stack-engineer.png';

/**
 * Hero portrait — a circular medallion with a rotating brand ring.
 *
 * This holds the page's LCP element, so it is loaded eagerly at high priority
 * and must never sit inside a `data-reveal` wrapper: those start at `opacity: 0`
 * and only clear once the deferred JS bundle runs, which would gate LCP on
 * JavaScript. See the comment in Hero.astro where it is used.
 *
 * Ported from the CodeWindow illustration this replaces: the floating tech
 * badges keep their original depths and delays, so the parallax and float
 * rhythm are unchanged — only their positions moved from a rectangle's corners
 * onto the circle's circumference.
 */
const floatingIcons = [
  { icon: 'simple-icons:laravel', class: 'top-[4%] -left-3 sm:-left-5', depth: 26, delay: '0s' },
  {
    icon: 'simple-icons:nodedotjs',
    class: 'top-[24%] -right-3 sm:-right-5',
    depth: 34,
    delay: '1.1s',
  },
  { icon: 'simple-icons:vuedotjs', class: 'bottom-[4%] left-[18%]', depth: 22, delay: '2.2s' },
  {
    icon: 'simple-icons:docker',
    class: 'bottom-[26%] -left-4 sm:-left-6',
    depth: 30,
    delay: '0.6s',
  },
  { icon: 'simple-icons:redis', class: '-top-3 right-[18%]', depth: 18, delay: '1.7s' },
];

/*
  Every width is well under the 1254px source, so Astro never has to fall back —
  it does not upscale. Covers 1x and 2x at each breakpoint without adding a
  candidate a high-DPR desktop would pick needlessly.
*/
const widths = [320, 448, 640, 896];

/*
  Caps the non-srcset fallback at 896 too. Without it Astro emits a fifth
  variant at the full 1254px and points `src` there — 73 KB no browser with
  srcset support ever fetches. Still square, so the reserved box is unchanged.
*/
---

<div
  class="portrait relative mx-auto w-full max-w-[20rem] sm:max-w-[22rem] lg:max-w-[24rem] xl:max-w-[26rem]"
>
  <div class="portrait__glow absolute -inset-8 -z-10 rounded-full" aria-hidden="true"></div>

  {/* The parallax target, reusing the --parallax-x/y contract from pointer.ts. */}
  <div class="portrait__medallion relative aspect-square" data-parallax="10">
    {
      /* Clip lives on an inner element so the ring and hairline, which sit at
        negative insets, are not cut off by it. */
    }
    <div class="absolute inset-0 overflow-hidden rounded-full shadow-lift">
      <Image
        src={portrait}
        alt={`${site.name} — ${site.role}`}
        widths={widths}
        width={896}
        sizes="(min-width: 1280px) 416px, (min-width: 1024px) 384px, (min-width: 640px) 352px, 320px"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-full w-full object-cover object-top"
      />
    </div>

    <span
      class="portrait__ring pointer-events-none absolute -inset-[6px] rounded-full"
      aria-hidden="true"></span>
    <span
      class="pointer-events-none absolute -inset-5 rounded-full border border-border-base"
      aria-hidden="true"></span>
  </div>

  {
    floatingIcons.map((item) => (
      <span
        class={`floating-icon glass absolute z-10 grid h-11 w-11 place-items-center rounded-2xl shadow-soft sm:h-13 sm:w-13 ${item.class}`}
        style={`--float-delay:${item.delay}`}
        data-parallax={item.depth}
        aria-hidden="true"
      >
        <Icon name={item.icon} width={20} height={20} class="text-text-muted" />
      </span>
    ))
  }
</div>

<style>
  .portrait__glow {
    background: radial-gradient(
      circle at 50% 35%,
      color-mix(in oklab, var(--primary) 32%, transparent),
      transparent 70%
    );
    filter: blur(2.5rem);
  }

  .portrait__medallion {
    translate: var(--parallax-x, 0) var(--parallax-y, 0);
    transition: translate 0.5s var(--ease-out-expo);
  }

  /*
    A radial-gradient mask, NOT the content-box `mask-composite: exclude` trick
    used by Card.astro. Mask clip boxes are rectangles and ignore border-radius:
    on a rounded rect at 1px the error is invisible, but on a circle the
    rectangular hole would leave four disconnected arcs instead of a ring.

    `closest-side` resolves to half the width on a square element, so the ring
    stays perfectly circular at every breakpoint with no size arithmetic.
    Prefixed first, unprefixed last — the minifier collapses the pair to the
    last declaration (see the note on `@utility glass` in global.css).
  */
  .portrait__ring {
    background: conic-gradient(
      from 210deg,
      var(--fill-from),
      var(--fill-via) 33%,
      var(--fill-to) 66%,
      var(--fill-from)
    );
    -webkit-mask: radial-gradient(
      closest-side,
      transparent calc(100% - 3px),
      #000 calc(100% - 3px)
    );
    mask: radial-gradient(closest-side, transparent calc(100% - 3px), #000 calc(100% - 3px));
    animation: ring-spin 22s linear infinite;
  }

  /* Conic gradient closes back on --fill-from, so the rotation has no seam. */
  @keyframes ring-spin {
    to {
      rotate: 360deg;
    }
  }

  .floating-icon {
    translate: var(--parallax-x, 0) var(--parallax-y, 0);
    animation: float 7s ease-in-out infinite;
    animation-delay: var(--float-delay, 0s);
    transition: translate 0.5s var(--ease-out-expo);
  }

  /*
    `animation: none`, not the global 0.01ms clamp — that would freeze the ring
    at a near-random rotation. This holds it at the authored `from 210deg`.
    Parallax needs no guard: initPointer() returns early under reduced motion.
  */
  @media (prefers-reduced-motion: reduce) {
    .floating-icon,
    .portrait__ring {
      animation: none;
    }
  }
</style>
