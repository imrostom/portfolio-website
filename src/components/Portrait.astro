---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import portrait from '../assets/md-rostom-ali-senior-full-stack-engineer.png';

/**
 * Hero portrait — a circular medallion with a rotating brand ring.
 *
 * This holds the page's LCP element, so it is loaded eagerly at high priority
 * and must never sit inside a `data-reveal` wrapper: those start at `opacity: 0`
 * and only clear once the deferred JS bundle runs, which would gate LCP on
 * JavaScript. See the comment in Hero.astro where it is used.
 *
 * Ported from the CodeWindow illustration this replaces: the floating tech
 * badges keep their original depth range and float rhythm, so the parallax feel
 * is unchanged — only their positions moved from a rectangle's corners onto the
 * circle's circumference.
 *
 * `angle` is degrees clockwise from top dead centre. The list is ordered by
 * angle so the ring reads as a sequence rather than a scatter; the sequence
 * starts at 18° so nothing lands on 0° and crowds the top of the head.
 * Colours are the vendors' own brand hexes — simple-icons paths are monochrome
 * and inherit `currentColor`, so setting `color` on the badge tints the glyph.
 * React and PHP use each vendor's light-background variant rather than the
 * simple-icons default (#61DAFB, #8892BF): the site is light-only and those two
 * all but vanish against the near-white glass badge.
 */
const floatingIcons = [
  { icon: 'simple-icons:react', angle: 18, color: '#087EA4', depth: 34, delay: '0s' },
  { icon: 'simple-icons:nodedotjs', angle: 54, color: '#5FA04E', depth: 26, delay: '1.1s' },
  { icon: 'simple-icons:laravel', angle: 90, color: '#FF2D20', depth: 30, delay: '2.2s' },
  { icon: 'simple-icons:php', angle: 126, color: '#777BB4', depth: 22, delay: '0.6s' },
  { icon: 'simple-icons:mysql', angle: 162, color: '#00758F', depth: 34, delay: '1.7s' },
  { icon: 'simple-icons:docker', angle: 198, color: '#2496ED', depth: 26, delay: '2.8s' },
  { icon: 'simple-icons:redis', angle: 234, color: '#FF4438', depth: 18, delay: '0.3s' },
  { icon: 'simple-icons:googlecloud', angle: 270, color: '#4285F4', depth: 30, delay: '1.4s' },
  { icon: 'simple-icons:digitalocean', angle: 306, color: '#0080FF', depth: 22, delay: '2.5s' },
  { icon: 'simple-icons:vuedotjs', angle: 342, color: '#41B883', depth: 34, delay: '0.9s' },
];

/*
  Badge centres sit exactly on the circumference — half in, half out — which is
  where the hand-placed offsets they replace already put them. The medallion is
  square, so 50% of the box is the radius on both axes and one percentage pair
  works at every breakpoint. `translate: -50% -50%` on the badge recentres it;
  the parallax offset is composed onto that same property in CSS.
*/
const place = (angle: number) => {
  const rad = (angle * Math.PI) / 180;
  return {
    left: `${(50 + 50 * Math.sin(rad)).toFixed(3)}%`,
    top: `${(50 - 50 * Math.cos(rad)).toFixed(3)}%`,
  };
};

/*
  Every width is well under the 1254px source, so Astro never has to fall back —
  it does not upscale. Covers 1x and 2x at each breakpoint without adding a
  candidate a high-DPR desktop would pick needlessly.
*/
const widths = [320, 448, 640, 896];

/*
  Caps the non-srcset fallback at 896 too. Without it Astro emits a fifth
  variant at the full 1254px and points `src` there — 73 KB no browser with
  srcset support ever fetches. Still square, so the reserved box is unchanged.
*/
---

<div
  class="portrait relative mx-auto w-full max-w-[20rem] sm:max-w-[22rem] lg:max-w-[24rem] xl:max-w-[26rem]"
>
  <div class="portrait__glow absolute -inset-8 -z-10 rounded-full" aria-hidden="true"></div>

  {/* The parallax target, reusing the --parallax-x/y contract from pointer.ts. */}
  <div class="portrait__medallion relative aspect-square" data-parallax="10">
    {
      /* Clip lives on an inner element so the ring and hairline, which sit at
        negative insets, are not cut off by it. */
    }
    <div class="absolute inset-0 overflow-hidden rounded-full shadow-lift">
      <Image
        src={portrait}
        alt={`${site.name} — ${site.role}`}
        widths={widths}
        width={896}
        sizes="(min-width: 1280px) 416px, (min-width: 1024px) 384px, (min-width: 640px) 352px, 320px"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-full w-full object-cover object-top"
      />
    </div>

    <span
      class="portrait__ring pointer-events-none absolute -inset-[6px] rounded-full"
      aria-hidden="true"></span>
    <span
      class="pointer-events-none absolute -inset-5 rounded-full border border-border-base"
      aria-hidden="true"></span>
  </div>

  {
    floatingIcons.map((item) => {
      const { left, top } = place(item.angle);
      return (
        <span
          class="floating-icon glass absolute z-10 grid h-10 w-10 place-items-center rounded-2xl shadow-soft sm:h-12 sm:w-12"
          style={`--float-delay:${item.delay};left:${left};top:${top};color:${item.color}`}
          data-parallax={item.depth}
          aria-hidden="true"
        >
          <Icon name={item.icon} width={20} height={20} />
        </span>
      );
    })
  }
</div>

<style>
  .portrait__glow {
    background: radial-gradient(
      circle at 50% 35%,
      color-mix(in oklab, var(--primary) 32%, transparent),
      transparent 70%
    );
    filter: blur(2.5rem);
  }

  .portrait__medallion {
    translate: var(--parallax-x, 0) var(--parallax-y, 0);
    transition: translate 0.5s var(--ease-out-expo);
  }

  /*
    A radial-gradient mask, NOT the content-box `mask-composite: exclude` trick
    used by Card.astro. Mask clip boxes are rectangles and ignore border-radius:
    on a rounded rect at 1px the error is invisible, but on a circle the
    rectangular hole would leave four disconnected arcs instead of a ring.

    `closest-side` resolves to half the width on a square element, so the ring
    stays perfectly circular at every breakpoint with no size arithmetic.
    Prefixed first, unprefixed last — the minifier collapses the pair to the
    last declaration (see the note on `@utility glass` in global.css).
  */
  .portrait__ring {
    background: conic-gradient(
      from 210deg,
      var(--fill-from),
      var(--fill-via) 33%,
      var(--fill-to) 66%,
      var(--fill-from)
    );
    -webkit-mask: radial-gradient(
      closest-side,
      transparent calc(100% - 3px),
      #000 calc(100% - 3px)
    );
    mask: radial-gradient(closest-side, transparent calc(100% - 3px), #000 calc(100% - 3px));
    animation: ring-spin 22s linear infinite;
  }

  /* Conic gradient closes back on --fill-from, so the rotation has no seam. */
  @keyframes ring-spin {
    to {
      rotate: 360deg;
    }
  }

  /*
    The -50% pair recentres the badge on the point its inline left/top places on
    the circumference; the parallax offset rides on top of it. Both have to live
    in one `translate` — a second declaration would overwrite the first, not
    compose with it, and the badges would hang off their anchor points.
  */
  .floating-icon {
    translate: calc(-50% + var(--parallax-x, 0px)) calc(-50% + var(--parallax-y, 0px));
    animation: float 7s ease-in-out infinite;
    animation-delay: var(--float-delay, 0s);
    transition: translate 0.5s var(--ease-out-expo);
  }

  /*
    `animation: none`, not the global 0.01ms clamp — that would freeze the ring
    at a near-random rotation. This holds it at the authored `from 210deg`.
    Parallax needs no guard: initPointer() returns early under reduced motion.
  */
  @media (prefers-reduced-motion: reduce) {
    .floating-icon,
    .portrait__ring {
      animation: none;
    }
  }
</style>
