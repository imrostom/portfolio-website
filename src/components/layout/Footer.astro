---
import { Icon } from 'astro-icon/components';
import { navigation, site, socials, contact } from '../../data/site';

const year = new Date().getFullYear();

// Split the nav across two columns by length rather than a fixed index, so
// adding or removing a page can't leave one column lopsided.
const splitAt = Math.ceil(navigation.length / 2);
const navPrimary = navigation.slice(0, splitAt);
const navSecondary = navigation.slice(splitAt);
---

<footer class="relative mt-auto" transition:name="site-footer">
  {/* Animated gradient hairline separating the footer from the page. */}
  <div class="gradient-hairline h-px w-full" aria-hidden="true"></div>

  <div class="container-page py-10 sm:py-12">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-sm">
        <a href="/" class="flex items-center gap-2.5 text-sm font-semibold tracking-tight">
          <span
            class="grid h-9 w-9 place-items-center rounded-xl brand-fill font-display text-[0.8rem] font-bold"
            aria-hidden="true">{site.initials}</span
          >
          {site.name}
        </a>
        <p class="mt-4 text-sm leading-relaxed text-text-muted">
          {
            `${site.role} building scalable SaaS platforms, logistics systems and AI-powered products from ${contact.locationShort}.`
          }
        </p>

        <ul class="mt-6 flex items-center gap-2">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  class="group/social inline-flex h-10 w-10 items-center justify-center rounded-full border border-border-base text-text-muted transition-all duration-300 hover:-translate-y-0.5 hover:border-border-strong hover:bg-surface hover:text-text"
                  aria-label={social.label}
                  {...(social.href.startsWith('http')
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                >
                  <Icon name={social.icon} width={16} height={16} aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-3">
        <nav aria-labelledby="footer-nav-heading">
          <h2
            id="footer-nav-heading"
            class="font-sans text-xs font-semibold tracking-widest text-text-dim uppercase"
          >
            Navigate
          </h2>
          <ul class="mt-4 flex flex-col gap-2.5">
            {
              navPrimary.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="footer-link text-sm text-text-muted transition-colors hover:text-text"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-labelledby="footer-more-heading">
          <h2
            id="footer-more-heading"
            class="font-sans text-xs font-semibold tracking-widest text-text-dim uppercase"
          >
            More
          </h2>
          <ul class="mt-4 flex flex-col gap-2.5">
            {
              navSecondary.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="footer-link text-sm text-text-muted transition-colors hover:text-text"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href={site.resumePath}
                download
                class="footer-link text-sm text-text-muted transition-colors hover:text-text"
              >
                Download Resume
              </a>
            </li>
          </ul>
        </nav>

        <div class="col-span-2 sm:col-span-1">
          <h2 class="font-sans text-xs font-semibold tracking-widest text-text-dim uppercase">
            Status
          </h2>
          <p class="mt-4 flex items-center gap-2 text-sm text-text-muted">
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span
                class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
              ></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            {contact.availability}
          </p>
          <p class="mt-3 text-sm text-text-muted">{contact.timezone}</p>
          <a
            href={`mailto:${contact.email}`}
            class="footer-link mt-3 inline-block text-sm text-text-muted transition-colors hover:text-text"
          >
            {contact.email}
          </a>
        </div>
      </div>
    </div>

    <div
      class="mt-9 flex flex-col items-center justify-between gap-4 border-t border-border-base pt-8 sm:flex-row"
    >
      {
        /*
        Whitespace between two adjacent expressions is stripped when a line
        break separates them, which silently produced "© 2026Md Rostom Ali".
        Building each run as a single template literal makes the spacing
        immune to however the formatter decides to wrap this.
      */
      }
      <p class="text-xs text-text-dim">
        {`© ${year} ${site.name}. All rights reserved.`}
      </p>

      <p class="text-xs text-text-dim">
        {`Designed and built in ${contact.locationShort} with `}
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link text-text-muted transition-colors hover:text-text">Astro</a
        >{' and '}<a
          href="https://tailwindcss.com"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link text-text-muted transition-colors hover:text-text">Tailwind CSS</a
        >.
      </p>
    </div>
  </div>
</footer>

<style>
  /* Underline grows from the left on hover. */
  .footer-link {
    position: relative;
  }

  .footer-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    height: 1px;
    width: 0;
    background: currentColor;
    transition: width 0.3s var(--ease-out-expo);
  }

  .footer-link:hover::after {
    width: 100%;
  }
</style>
