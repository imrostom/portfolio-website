---
import { Icon } from 'astro-icon/components';
import { navigation, site, contact } from '../../data/site';
import Button from '../ui/Button.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  data-site-header
  class="site-header fixed inset-x-0 top-0 z-50"
  transition:name="site-header"
>
  {/* Reading progress, pinned to the very top edge of the header. */}
  <div
    data-scroll-progress
    class="gradient-hairline absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0"
    aria-hidden="true"
  >
  </div>

  <nav class="container-page" aria-label="Primary">
    <div class="site-header__bar flex h-16 items-center justify-between gap-4 lg:h-18">
      <a
        href="/"
        class="group/logo flex items-center gap-2.5 rounded-full text-sm font-semibold tracking-tight"
        aria-label={`${site.name} — home`}
      >
        <span
          class="relative grid h-9 w-9 place-items-center overflow-hidden rounded-xl brand-fill shadow-[0_6px_18px_-6px_color-mix(in_oklab,var(--primary)_80%,transparent)] transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover/logo:scale-105"
        >
          <span class="font-display text-[0.8rem] font-bold">{site.initials}</span>
        </span>
        <span class="hidden sm:inline">{site.shortName}</span>
      </a>

      {/* Desktop navigation */}
      <ul class="hidden items-center gap-0.5 lg:flex">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link relative rounded-full px-3.5 py-2 text-sm text-text-muted transition-colors duration-300 hover:text-text"
                data-active={isActive(item.href) ? '' : undefined}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        {
          /*
          Availability status. Shown from `lg` up, where the desktop nav is
          already visible and there is room for it; on smaller screens the same
          status appears at the top of the mobile drawer instead.
        */
        }
        <a
          href="/contact"
          class="availability hidden items-center gap-2 rounded-full border border-emerald-500/35 bg-emerald-500/10 px-3 py-1.5 text-xs font-medium text-emerald-700 transition-colors duration-300 hover:bg-emerald-500/15 lg:inline-flex"
        >
          <span class="availability__dot relative flex h-1.5 w-1.5" aria-hidden="true">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
            ></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          </span>
          Available for work
        </a>

        {
          /* Resume is no longer in the nav, so this CTA is the primary route to
            the résumé page. The PDF download lives on that page itself. */
        }
        <Button
          href="/resume"
          size="sm"
          variant="primary"
          icon="lucide:file-text"
          class="hidden sm:inline-flex"
        >
          Resume
        </Button>

        <button
          type="button"
          data-nav-toggle
          class="nav-toggle inline-flex h-10 w-10 items-center justify-center rounded-full border border-border-base text-text transition-colors duration-300 hover:bg-surface lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Open navigation menu"
        >
          <span class="nav-toggle__box" aria-hidden="true">
            <span class="nav-toggle__line"></span>
            <span class="nav-toggle__line"></span>
          </span>
        </button>
      </div>
    </div>
  </nav>
</header>

{
  /*
  The drawer lives OUTSIDE <header> deliberately. The header carries
  `backdrop-filter`, which — like `filter` and `transform` — makes it the
  containing block for any `position: fixed` descendant. Nested inside, the
  drawer's `top-16 bottom-0` resolved against the header's 64px box instead of
  the viewport, collapsing it to zero height. As a sibling it is fixed to the
  viewport as intended, and its z-40 keeps it beneath the z-50 bar so the close
  button stays reachable.
*/
}
{/* Mobile drawer */}
<div
  id="mobile-nav"
  data-nav-panel
  hidden
  class="nav-panel fixed inset-x-0 top-16 bottom-0 z-40 lg:hidden"
>
  <div class="nav-panel__sheet glass h-full overflow-y-auto px-5 pt-6 pb-10">
    {/* Same status as the desktop pill, surfaced where there is room for it. */}
    <p
      class="mb-5 inline-flex items-center gap-2 rounded-full border border-emerald-500/35 bg-emerald-500/10 px-3 py-1.5 text-xs font-medium text-emerald-700"
    >
      <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
        ></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
      </span>
      {contact.availability}
    </p>

    <ul class="flex flex-col gap-1">
      {
        navigation.map((item, index) => (
          <li class="nav-panel__item" style={`--nav-index:${index}`}>
            <a
              href={item.href}
              class="flex items-center gap-3 rounded-2xl px-4 py-3.5 text-base text-text-muted transition-colors duration-200 hover:bg-surface hover:text-text data-[active]:bg-surface data-[active]:text-text"
              data-active={isActive(item.href) ? '' : undefined}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <Icon name={item.icon} width={18} height={18} aria-hidden="true" />
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-6 border-t border-border-base pt-6">
      <Button href="/resume" variant="primary" class="w-full" icon="lucide:file-text">
        View Resume
      </Button>
    </div>
  </div>
</div>

<style>
  /*
    The frosted panel is always on, so the bar reads as a solid piece of chrome
    from the first paint rather than materialising on scroll. Saturation is
    lifted so the aurora behind it still shows as colour rather than going grey.
  */
  .site-header {
    background-color: color-mix(in oklab, var(--bg) 86%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--border);
    transition:
      background-color 0.4s var(--ease-out-expo),
      box-shadow 0.4s var(--ease-out-expo);
  }

  /*
    Scrolled state is now a lift rather than an appearance: the panel goes a
    little more opaque and picks up a shadow, which keeps the "content is
    underneath me" cue without the bar changing character.
  */
  .site-header[data-scrolled] {
    background-color: color-mix(in oklab, var(--bg) 94%, transparent);
    box-shadow:
      0 1px 0 rgb(15 23 42 / 0.03),
      0 10px 30px -18px rgb(15 23 42 / 0.28);
  }

  /* Backdrop-filter creates a stacking context; keep the bar's own content
     painting above it. */
  .site-header > nav,
  .site-header > [data-scroll-progress] {
    position: relative;
    z-index: 1;
  }

  /* Animated underline that grows from the centre. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.3rem;
    height: 2px;
    width: 0;
    translate: -50% 0;
    border-radius: 9999px;
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    transition: width 0.35s var(--ease-out-expo);
  }

  .nav-link:hover::after {
    width: 40%;
  }

  .nav-link[data-active] {
    color: var(--text);
  }

  .nav-link[data-active]::after {
    width: 55%;
  }

  /* Hamburger that morphs into a close icon. */
  .nav-toggle__box {
    position: relative;
    display: block;
    width: 18px;
    height: 12px;
  }

  .nav-toggle__line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 9999px;
    background: currentColor;
    transition:
      top 0.25s var(--ease-out-expo),
      rotate 0.25s var(--ease-out-expo),
      width 0.25s var(--ease-out-expo);
  }

  .nav-toggle__line:nth-child(1) {
    top: 0;
  }
  .nav-toggle__line:nth-child(2) {
    top: 10px;
    width: 70%;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__line:nth-child(1) {
    top: 5px;
    rotate: 45deg;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__line:nth-child(2) {
    top: 5px;
    width: 100%;
    rotate: -45deg;
  }

  .nav-panel {
    opacity: 0;
    transition:
      opacity 0.25s var(--ease-out-expo),
      visibility 0.25s;
  }

  .nav-panel[data-open] {
    opacity: 1;
  }

  .nav-panel__sheet {
    border-radius: 0;
    border-left: none;
    border-right: none;
    background-color: color-mix(in oklab, var(--bg) 92%, transparent);
    translate: 0 -8px;
    transition: translate 0.35s var(--ease-out-expo);
  }

  .nav-panel[data-open] .nav-panel__sheet {
    translate: 0 0;
  }

  /* Stagger the links in as the drawer opens. */
  .nav-panel__item {
    opacity: 0;
    translate: 0 10px;
    transition:
      opacity 0.35s var(--ease-out-expo),
      translate 0.35s var(--ease-out-expo);
    transition-delay: calc(var(--nav-index) * 45ms + 80ms);
  }

  .nav-panel[data-open] .nav-panel__item {
    opacity: 1;
    translate: 0 0;
  }
</style>
