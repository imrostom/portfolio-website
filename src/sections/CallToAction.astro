---
import { Icon } from 'astro-icon/components';
import { contact } from '../data/site';
import Button from '../components/ui/Button.astro';

interface Props {
  heading?: string;
  description?: string;
}

const {
  heading = "Let's build something amazing together.",
  description = "Whether it's a platform that needs to scale, a system that needs untangling, or a product idea that needs a technical partner — I'd like to hear about it.",
} = Astro.props;
---

<section class="relative py-14 sm:py-18" aria-labelledby="cta-heading">
  <div class="container-page">
    <div
      class="cta-panel relative overflow-hidden rounded-3xl px-6 py-12 text-center sm:px-12 sm:py-14"
    >
      {/* Animated gradient field */}
      <div class="cta-panel__aurora absolute inset-0" aria-hidden="true"></div>
      <div class="cta-panel__grid absolute inset-0" aria-hidden="true"></div>

      <div class="relative">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3.5 py-1.5 text-xs font-medium text-white backdrop-blur-md"
          data-reveal="fade"
        >
          <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-300 opacity-75"
            ></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
          </span>
          {contact.availability}
        </span>

        <h2
          id="cta-heading"
          class="mx-auto mt-5 max-w-2xl text-2xl leading-tight font-semibold text-white sm:text-3xl lg:text-4xl"
          data-reveal="slide"
          style="--reveal-delay:70ms"
        >
          {heading}
        </h2>

        <p
          class="mx-auto mt-4 max-w-xl text-[0.95rem] leading-relaxed text-white/85 sm:text-base"
          data-reveal="slide"
          style="--reveal-delay:140ms"
        >
          {description}
        </p>

        <div
          class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row"
          data-reveal="slide"
          style="--reveal-delay:210ms"
        >
          <a
            href={`mailto:${contact.email}`}
            class="group/cta inline-flex h-13 items-center justify-center gap-2 rounded-full bg-white px-7 text-base font-medium text-slate-900 shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl"
            data-magnetic
          >
            <Icon name="lucide:mail" width={18} height={18} aria-hidden="true" />
            {contact.email}
          </a>

          <Button
            href="/contact"
            size="lg"
            variant="outline"
            iconRight="lucide:arrow-right"
            class="border-white/35 text-white hover:bg-white/10"
            magnetic
          >
            All contact details
          </Button>
        </div>

        <p class="mt-6 text-sm text-white/75" data-reveal="fade" style="--reveal-delay:280ms">
          Based in {contact.locationShort} · {contact.timezone}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-panel {
    background: linear-gradient(135deg, #1e40af, #6d28d9 52%, #0e7490);
    box-shadow: 0 30px 80px -30px rgb(37 99 235 / 0.55);
  }

  .cta-panel__aurora {
    background:
      radial-gradient(circle at 18% 22%, rgb(255 255 255 / 0.28), transparent 45%),
      radial-gradient(circle at 82% 78%, rgb(6 182 212 / 0.42), transparent 50%);
    animation: aurora 16s ease-in-out infinite alternate;
  }

  .cta-panel__grid {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.07) 1px, transparent 1px);
    background-size: 46px 46px;
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, #000, transparent 75%);
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, #000, transparent 75%);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-panel__aurora {
      animation: none;
    }
  }
</style>
