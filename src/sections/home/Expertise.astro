---
import { Icon } from 'astro-icon/components';
import { focusAreas } from '../../data/about';
import { site } from '../../data/site';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
---

<Section aria-labelledby="expertise-heading">
  <SectionHeading
    id="expertise-heading"
    eyebrow="What I do"
    eyebrowIcon="lucide:sparkles"
    title="Depth where it"
    titleAccent="matters"
    description={`${site.yearsExperience} years concentrated on the parts of a system that decide whether it holds up: data modelling, tenancy, throughput and the workflows around them.`}
  />

  <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group="70">
    {
      focusAreas.map((area) => (
        <li
          class="expertise-card group/exp relative overflow-hidden rounded-2xl glass p-5"
          data-reveal="slide"
        >
          <span
            class="expertise-card__icon grid h-11 w-11 place-items-center rounded-2xl border border-border-base bg-bg-inset text-text-muted transition-all duration-500"
            aria-hidden="true"
          >
            <Icon name={area.icon} width={19} height={19} />
          </span>

          <h3 class="mt-5 font-display text-lg font-semibold">{area.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">{area.description}</p>

          {/* Corner bloom on hover */}
          <span class="expertise-card__bloom pointer-events-none absolute -top-16 -right-16 h-32 w-32 rounded-full" />
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .expertise-card {
    transition:
      transform 0.5s var(--ease-out-expo),
      border-color 0.5s var(--ease-out-expo);
  }

  .expertise-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklab, var(--primary) 32%, transparent);
  }

  .expertise-card:hover .expertise-card__icon {
    border-color: color-mix(in oklab, var(--primary) 45%, transparent);
    background-color: color-mix(in oklab, var(--primary) 12%, transparent);
    color: var(--primary);
    transform: translateY(-2px) scale(1.05);
  }

  .expertise-card__bloom {
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--primary) 30%, transparent),
      transparent 68%
    );
    opacity: 0;
    transition: opacity 0.5s var(--ease-out-expo);
  }

  .expertise-card:hover .expertise-card__bloom {
    opacity: 1;
  }
</style>
